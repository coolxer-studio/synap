CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_EVENT_TASK_STACK_SIZE=3072
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_GCM_C=y
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_PEM_PARSE_C=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_TLS_USE_SECURE_ELEMENT=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_SYNAP_PROVISION_PARTITION="provision"
CONFIG_SYNAP_RUNTIME_PARTITION="runtime"
CONFIG_SYNAP_SPOOL_PARTITION="spool"
CONFIG_SYNAP_DEAD_LETTER_PARTITION="dead_letter"
CONFIG_SYNAP_QUEUE_MAX_RECORDS=128
CONFIG_SYNAP_QUEUE_MAX_RECORD_BYTES=32768
CONFIG_SYNAP_DEAD_LETTER_MAX_RECORDS=16
CONFIG_SYNAP_WORKER_STACK_SIZE=12288
CONFIG_SYNAP_ALLOW_INSECURE_HTTP=n

