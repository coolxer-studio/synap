    "size": "node config/size.js",
    "ci": "npm run lint && npm test && npm run build:prod && npm run size"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.28.0",
    "@eslint/js": "9.39.5",
    "babel-loader": "9.2.1",
    "eslint": "9.39.5",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.109.2",
    "webpack-cli": "6.0.1"
  },
  "browserslist": [
    "Chrome >= 89",
    "iOS >= 14"
  ]
}
