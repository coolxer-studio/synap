{
  "name": "synap-agent-miniprogram",
  "version": "1.0.0",
  "description": "Synap security agent for WeChat Mini Program",
  "main": "dist/agent.min.js",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "webpack --config config/webpack.config.js --mode development --watch",
    "lint": "eslint src config/*.js test/*.cjs",
    "test": "node --test test/*.test.cjs",
    "build:prod": "node config/build.js",
