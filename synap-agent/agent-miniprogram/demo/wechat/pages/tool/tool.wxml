<navigation-bar title="测试工具" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="userinfo" bindtap="trackTap">
    <button bindtap="sendOpaqueUser">发送虚拟脱敏用户数据</button>
    <button bindtap="markLogin">记录登录动作窗口</button>
    <button bindtap="triggerError">触发脱敏错误</button>
    <button bindtap="retryUpload">离线/重试测试</button>
    <button bindtap="simulateDebugPause">调试长暂停检测</button>
    <button bindtap="showMetrics">查看探针指标</button>
    <text selectable="true">{{output}}</text>
  </view>
</scroll-view>
