<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_200"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/communication_settings_base_url"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_communication_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_button_white"
            android:hint="https://example.com"
            android:inputType="textUri"
            android:padding="12dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/communication_settings_app_id"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_communication_app_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_button_white"
            android:hint="synap-android"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:padding="12dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/communication_settings_server_key_id"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_communication_server_key_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_button_white"
            android:hint="server-key-2026"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:padding="12dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/communication_settings_trust_anchor"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_communication_trust_anchor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_button_white"
            android:gravity="top|start"
            android:hint="P-256 SPKI Base64URL"
            android:inputType="textMultiLine|textVisiblePassword|textNoSuggestions"
            android:minLines="5"
            android:padding="12dp" />

        <Button
            android:id="@+id/button_save_communication_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/rounded_button_blue"
            android:text="@string/communication_settings_save"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
