  "protectionPolicy": {
    "mode": "observe",
    "blockCapableRules": ["COMMAND_INJECTION_V1", "SSRF_PRIVATE_TARGET_V1", "PATH_TRAVERSAL_V1"]
  },
  "dependencyPolicy": {
    "enabled": true,
    "catalogProvider": "osv-file"
  }
}
