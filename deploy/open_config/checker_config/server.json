{
  "policyVersion": "server-1.0.0",
  "startConfig": [1, 60.0, 600.0, 10.0, 864000.0],
  "apiPolicy": {
    "enabled": true,
    "observationWindowSeconds": 60,
    "maxAssets": 5000,
    "collectBody": false
