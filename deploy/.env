# Compose 项目；同时适用于 Docker Compose v2 和 legacy docker-compose 1.29.2
COMPOSE_PROJECT_NAME=synap
TZ=Asia/Shanghai
SYNAP_PORT=11099

# 镜像；IMAGE_ARCH 可选 amd64 或 arm64
SYNAP_IMAGE=crpi-4pdi7kz96g4v0tg3.cn-beijing.personal.cr.aliyuncs.com/coolxer-studio/synap-server
SYNAP_IMAGE_TAG=1.0.0.alpha
IMAGE_ARCH=arm64

# JVM 容器内存比例，可根据容器 limit 调整
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=25.0 -Dfile.encoding=UTF-8

# 与 Kafka、Redis、Zenvis 等服务共享的 Docker 网络
ZENVIS_NETWORK_NAME=zenvis_zenvis-network

# 基础设施与下游服务(redis密码必须根据实际部署环境做修改)
KAFKA_BOOTSTRAP_SERVERS=kafka-service:9092
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICAS=1
KAFKA_PUBLISH_TIMEOUT=PT5S
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=Zv!fa6b514adab6ead05214cf0eAa
ASSET_SERVICE_URL=http://asset-service:11003
OPERATION_SERVICE_URL=http://operation-service:11004
RISK_SERVICE_URL=http://risk-service:11005

# 请按实际网关 CIDR 和浏览器 Origin 配置；服务直连时保持空值
SYNAP_TRUSTED_PROXIES=10.20.0.0/16
SYNAP_CORS_ALLOWED_ORIGINS=http://localhost:8888,http://127.0.0.1:8888
SYNAP_APP_ORIGINS=
SYNAP_WECHAT_APPIDS=
SYNAP_REQUIRE_WECHAT_APPID=true

# 安全通信 v1；生产启用前必须重新生成且通过密钥管理系统注入下列敏感值
SYNAP_SC_ENABLED=true
SYNAP_SC_REQUIRE_TLS=false
SYNAP_SC_SERVER_KEY_ID=server-key-test
SYNAP_SC_SERVER_PRIVATE_KEY=MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgyCUBsbxL6poK8vHu2P21aRs5yuZv18ndn0r5syJSH3KhRANCAARufm9VSYM10a3qSKcDepkGuumTl7f0Ls2Q_O4rzP7_EDVY2aqmZe9S9umVwN_NOekREzJqszteH7DdQULLtpc5
SYNAP_SC_SERVER_PUBLIC_KEY=MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEbn5vVUmDNdGt6kinA3qZBrrpk5e39C7NkPzuK8z-_xA1WNmqpmXvUvbplcDfzTnpERMyarM7Xh-w3UFCy7aXOQ
SYNAP_SC_SESSION_RECORD_KEY=uFNMHkz4AN5J4S-jWXChUjb6E0Kj9XHWjVwBTF4QLMA
SYNAP_SC_ALLOWED_APP_IDS=synap-h5-test,synap-host-test,synap-server-test,synap-android-test,synap-ios-test,synap-ios-dev
SYNAP_SC_ENROLLMENT_ADMIN_TOKEN=uAQC4KLx7IwGPgr9XUp62RtXWYt8w64RTJGoTHtQ94s16ed035df2b8d04131dfa1a08b7831ce0d83d4982b203c9779ef3c06849ea521

# Zenvis 服务上报
ZENVIS_BUSINESS_SERVICE_ENABLED=true
ZENVIS_BASE_URL=http://zenvis-backend:11001
