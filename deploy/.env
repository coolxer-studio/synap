# Compose 项目
COMPOSE_PROJECT_NAME=synap
TZ=Asia/Shanghai
SYNAP_PORT=11099

# 镜像；IMAGE_ARCH 可选 amd64 或 arm64
SYNAP_IMAGE=crpi-4pdi7kz96g4v0tg3.cn-beijing.personal.cr.aliyuncs.com/coolxer-studio/synap-server
SYNAP_IMAGE_TAG=latest
IMAGE_ARCH=arm64

# JVM 容器内存比例，可根据容器 limit 调整
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=25.0 -Dfile.encoding=UTF-8

# 与 Kafka、Redis、Zenvis 等服务共享的 Docker 网络
ZENVIS_NETWORK_NAME=deploy_zenvis-network

# 基础设施与下游服务
KAFKA_BOOTSTRAP_SERVERS=kafka-service:9092
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICAS=1
KAFKA_PUBLISH_TIMEOUT=PT5S
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=
ASSET_SERVICE_URL=http://192.168.0.101:11003
OPERATION_SERVICE_URL=http://192.168.0.101:11004
RISK_SERVICE_URL=http://192.168.0.101:11005

# 请按实际网关 CIDR 和浏览器 Origin 配置；服务直连时保持空值
SYNAP_TRUSTED_PROXIES=
SYNAP_CORS_ALLOWED_ORIGINS=
SYNAP_APP_ORIGINS=
SYNAP_WECHAT_APPIDS=
SYNAP_REQUIRE_WECHAT_APPID=true

# 安全通信 v1；生产启用前必须通过密钥管理系统注入下列敏感值
SYNAP_SC_ENABLED=false
SYNAP_SC_REQUIRE_TLS=true
SYNAP_SC_SERVER_KEY_ID=
SYNAP_SC_SERVER_PRIVATE_KEY=
SYNAP_SC_SERVER_PUBLIC_KEY=
SYNAP_SC_SESSION_RECORD_KEY=
SYNAP_SC_ALLOWED_APP_IDS=
SYNAP_SC_ENROLLMENT_ADMIN_TOKEN=

# Zenvis 服务上报
ZENVIS_BUSINESS_SERVICE_ENABLED=true
ZENVIS_BASE_URL=http://192.168.0.101:11001
